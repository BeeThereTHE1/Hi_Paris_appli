{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2015",
    "outDir": "./dist/exoquizjs",
    "removeComments": true,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "types": ["d3", "seedrandom"],
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
