{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "./dist/exoquizjs",
    "rootDir": "./src/exos",
    "removeComments": true,
    "preserveConstEnums": true,
    "skipLibCheck": true,
    "types": ["d3", "seedrandom"],
